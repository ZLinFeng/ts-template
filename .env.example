# Example runtime variables for the API, admin CLI and E2E suite.
# This project does not load .env automatically: export these values in your
# shell, or pass them through Docker/Kubernetes. Only non-secret defaults belong
# in this file.

# --- API -------------------------------------------------------------------
# Environment file selector: config/config-{API_ENV}.yaml (default: development)
API_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Relative paths are resolved from apps/api; use :memory: for an in-memory DB.
API_DB_PATH=.data/tasks.sqlite
# Optional explicit config file; takes precedence over API_CONFIG_DIR.
# API_CONFIG_FILE=./apps/api/config/config-development.yaml
# API_CONFIG_DIR=./apps/api/config

# --- Admin CLI -------------------------------------------------------------
# The CLI reads API_URL, or --api-url on the command line.
API_URL=http://127.0.0.1:3000

# --- E2E -------------------------------------------------------------------
# Leave E2E_BASE_URL empty for the self-contained local mode.
E2E_BASE_URL=
E2E_ALLOW_REMOTE=
E2E_API_URL=
E2E_STORAGE_STATE=
E2E_BROWSER_CHANNEL=
